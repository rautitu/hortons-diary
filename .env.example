APP_ENV=development
LOG_LEVEL=info
SESSION_COOKIE_SECURE=false

# Docker Compose host ports
APP_PORT=51201
POSTGRES_PORT=51202

# PostgreSQL container credentials (development only)
POSTGRES_DB=hortons
POSTGRES_USER=hortons
POSTGRES_PASSWORD=hortons

# Used when the Go application runs directly on the host
HTTP_ADDR=:51201
DATABASE_URL=postgres://hortons:hortons@localhost:51202/hortons?sslmode=disable
